# ---- 必須 ----------------------------------------------------------------
# アプリから見たこのサーバーの URL（招待QRに埋め込まれます）。必ず https。
PUBLIC_URL=https://call.example.com

# 最初の1台（オーナー）がグループを作るときだけ使う合言葉。
# グループを作り終えたら空にして再起動してください（以後、誰もグループを作れません）。
SETUP_TOKEN=change-me-long-random-string

# ---- TURN（NAT越え。スマホ回線同士の通話にほぼ必須） ------------------------
# coturn の static-auth-secret と同じ値。
TURN_SECRET=change-me-another-long-random-string
TURN_URLS=turn:call.example.com:3478?transport=udp,turn:call.example.com:3478?transport=tcp,turns:call.example.com:5349?transport=tcp
STUN_URLS=stun:call.example.com:3478

# ---- VoIP プッシュ（アプリを開いていなくても着信音を鳴らす） -----------------
# Apple Developer で作成した APNs Auth Key (.p8) の情報。未設定なら「アプリを開いている間だけ着信」になります。
APNS_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8
APNS_KEY_ID=XXXXXXXXXX
APNS_TEAM_ID=YYYYYYYYYY
APNS_BUNDLE_ID=com.example.kidscall
# 開発ビルド(Xcode から直接インストール)なら sandbox、TestFlight/App Store なら production
APNS_ENV=sandbox
