# ---- 必須（scripts/setup.sh が自動で埋めます） --------------------------------
# アプリが接続するドメイン。DNS の A レコードをこのサーバーに向けておくこと。
DOMAIN=call.example.com
PUBLIC_URL=https://call.example.com

# 最初の1台（管理者）がグループを作るときだけ使う合言葉。
# グループを作り終えたら空にして `docker compose restart signaling`（以後、誰もグループを作れません）。
SETUP_TOKEN=

# ---- TURN（NAT越え。スマホ回線同士の通話にほぼ必須） ------------------------
TURN_SECRET=
TURN_URLS=turn:call.example.com:3478?transport=udp,turn:call.example.com:3478?transport=tcp
STUN_URLS=stun:call.example.com:3478
# クラウド VPS で「サーバー自身は内部 IP しか知らない」場合はグローバル IP を指定
# 例: TURN_EXTRA_ARGS=--external-ip=203.0.113.10
TURN_EXTRA_ARGS=

# ---- VoIP プッシュ（アプリを閉じていても着信音を鳴らす。任意） ----------------
# Apple Developer で作成した APNs Auth Key (.p8) の情報。未設定なら「アプリを開いている間だけ着信」。
#APNS_KEY_PATH=/secrets/AuthKey_XXXXXXXXXX.p8
#APNS_KEY_ID=XXXXXXXXXX
#APNS_TEAM_ID=YYYYYYYYYY
#APNS_BUNDLE_ID=com.example.kidscall
# Xcode から直接インストールしたビルドは sandbox、TestFlight/App Store 配布は production
#APNS_ENV=sandbox
